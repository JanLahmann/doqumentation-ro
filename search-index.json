,["pregăt",{"_index":17,"t":{"12":{"position":[[10,8]]}}}],["prim",{"_index":0,"t":{"3":{"position":[[0,6]]}}}],["proiect",{"_index":14,"t":{"10":{"position":[[16,7]]}}}],["quantum",{"_index":11,"t":{"8":{"position":[[27,7]]}}}],["sourc",{"_index":9,"t":{"8":{"position":[[16,6]]}}}],["și",{"_index":5,"t":{"7":{"position":[[7,2]]}}}]],"pipeline":["stemmer","stemmer-de","stemmer-es","stemmer-fr","stemmer-it","stemmer-pt","stemmer-jp","stemmer-ar","stemmer-he","stemmer-ko"]}},{"documents":[{"i":1,"t":"Frontend open-source pentru tutorialele, cursurile și documentația IBM Quantum — cu execuție de cod live, direct în browser.","s":"doQumentation","u":"/","p":1}],"index":{"version":"2.3.9","fields":["t"],"fieldVectors":[["t/1",[0,0.288,1,0.288,2,0.288,3,0.288,4,0.288,5,0.288,6,0.288,7,0.288,8,0.288,9,0.288,10,0.288,11,0.288,12,0.288,13,0.288,14,0.288,15,0.288,16,0.288,17,0.288]]],"invertedIndex":[["browser.",{"_index":17,"t":{"1":{"position":[[116,8]]}}}],["cod",{"_index":13,"t":{"1":{"position":[[96,3]]}}}],["cu",{"_index":11,"t":{"1":{"position":[[81,2]]}}}],["cursuril",{"_index":5,"t":{"1":{"position":[[41,9]]}}}],["direct",{"_index":15,"t":{"1":{"position":[[106,6]]}}}],["documentaț",{"_index":7,"t":{"1":{"position":[[54,12]]}}}],["execuț",{"_index":12,"t":{"1":{"position":[[84,8]]}}}],["frontend",{"_index":0,"t":{"1":{"position":[[0,8]]}}}],["ibm",{"_index":8,"t":{"1":{"position":[[67,3]]}}}],["live,",{"_index":14,"t":{"1":{"position":[[100,5]]}}}],["open",{"_index":1,"t":{"1":{"position":[[9,4]]}}}],["pentru",{"_index":3,"t":{"1":{"position":[[21,6]]}}}],["quantum",{"_index":9,"t":{"1":{"position":[[71,7]]}}}],["sourc",{"_index":2,"t":{"1":{"position":[[14,6]]}}}],["tutorialele,",{"_index":4,"t":{"1":{"position":[[28,12]]}}}],["în",{"_index":16,"t":{"1":{"position":[[113,2]]}}}],["și",{"_index":6,"t":{"1":{"position":[[51,2]]}}}],["—",{"_index":10,"t":{"1":{"position":[[79,1]]}}}]],"pipeline":["stemmer","stemmer-de","stemmer-es","stemmer-fr","stemmer-it","stemmer-pt","stemmer-jp","stemmer-ar","stemmer-he","stemmer-ko"]}},{"documents":[],"index":{"version":"2.3.9","fields":["t"],"fieldVectors":[],"invertedIndex":[],"pipeline":["stemmer","stemmer-de","stemmer-es","stemmer-fr","stemmer-it","stemmer-pt","stemmer-jp","stemmer-ar","stemmer-he","stemmer-ko"]}},{"documents":[{"i":2,"t":"Învață calculul cuantic cu tutorialele și cursurile Qiskit de la IBM și rulează codul chiar aici, în browser. Fără instalare și fără cont pentru a începe. Rulează primul tău circuit cuanticRăsfoiește catalogul de cursuri 42Tutoriale 171Ghiduri 154Pagini de curs 14Module","s":"doQumentation","u":"/","h":"","p":1},{"i":4,"t":"Nou în calculul cuantic? Începe cu cursul. Ești deja familiarizat cu Qiskit? Sari direct la un tutorial sau ghid. Nu ai nevoie de un cont IBM Quantum. Implicit, codul rulează pe un simulator încorporat. Adaugă cheia ta API în Setări doar dacă vrei hardware cuantic real. CursBazele Informației CuanticeÎncepe aici — curs structurat de la sisteme individuale la entanglementTutorialHello World: Primul tău circuit cuanticIntroducerea proprie doQumentation — construiește o stare Bell, rulează-o în trei moduriGhidConstruiește circuiteGhidul IBM pentru construirea circuitelor cuantice în QiskitTutorialInegalitatea CHSHRulează un test Bell pe un calculator cuanticTutorialAlgoritmul lui GroverCaută mai rapid într-o listă nestructurată cu amplificarea amplitudinii","s":"Primii pași","u":"/","h":"#getting-started","p":1},{"i":6,"t":"Apasă Run pe orice bloc de cod. Prima apăsare pornește un kernel Jupyter prin Binder sau IBM Code Engine. După aceea, rulările sunt instantanee. Modul Simulator (fără cont) — Activat implicit: codul rulează pe AerSimulator sau pe FakeBackends cu model de zgomot pe care le poți alege în Setări. Paginile care necesită hardware IBM Quantum sau servicii cloud IBM te anunță când le rulezi. Hardware IBM Quantum — Introdu token-ul API și CRN-ul în Setări o singură dată — credențialele sunt injectate automat la fiecare rulare. Creează un cont gratuit dacă nu ai unul. Backend-uri de execuție disponibile Fiecare tutorial are blocuri de cod executabile. Apasă Run ca să le rulezi folosind unul din cele patru backend-uri: Binder (implicit pe GitHub Pages) — Kernel Jupyter la distanță gratuit prin mybinder.org IBM Code Engine — Jupyter serverless pe contul tău IBM Cloud. Cold start în secunde în loc de minute. Configurează Jupyter Local (Docker / RasQberry) — Se conectează la serverul Jupyter local cu Qiskit preinstalat Server personalizat — Indică orice endpoint Jupyter în Setări Când sunt disponibile mai multe backend-uri, alege care să fie folosit din Setări. Opțiuni de implementare doQumentation este disponibil ca: GitHub Pages — Site static cu Binder sau IBM Code Engine pentru execuție de cod la distanță Docker — Full stack local, capabil să funcționeze offline RasQberry — Self-hosted pe Raspberry Pi cu kernel Jupyter local Rulează local cu Podman / Docker Instalează Podman Desktop sau Docker Desktop (Mac / Windows / Linux), apoi rulează: # Full stack: site + Jupyter + Qiskit (~3 GB) podman run -p 8080:80 -p 8888:8888 ghcr.io/janlahmann/doqumentation:jupyter Deschide http://localhost:8080 — execuția codului funcționează local, fără timp de așteptare Binder. Folosești Docker în schimb? Înlocuiește podman cu docker — comenzile sunt identice. Imaginile sunt multi-arch (linux/amd64 + linux/arm64), deci Mac-urile Apple Silicon funcționează nativ.","s":"Execuția codului","u":"/","h":"#code-execution","p":1},{"i":9,"t":"IBM oferă o mulțime de materiale de învățare despre calculul cuantic — toate open-source sub CC BY-SA 4.0: Learning — Cursuri structurate de la bazele cuantice până la subiecte avansate Tutorials — Peste 40 de tutoriale despre transpilare, atenuarea erorilor și altele Documentation — Ghiduri și referință API pentru Qiskit Source repo — Tot conținutul pe GitHub Quantum Platform lor este mereu actualizat și bine proiectat — cel mai bun loc pentru citit, învățat și consultare.","s":"Conținutul open-source IBM Quantum","u":"/","h":"#ibm-quantums-open-source-content","p":1},{"i":11,"t":"Documentația Qiskit a IBM este open-source (CC BY-SA 4.0), dar aplicația lor web nu este. doQumentation adaugă un frontend open-source cu execuție de cod live, injectare automată a credențialelor și mod simulator. Poate fi implementat oriunde — de la GitHub Pages la Docker la RasQberry. Vezi toate funcțiile.","s":"Ce adaugă acest proiect","u":"/","h":"#what-this-project-adds","p":1},{"i":13,"t":"doQumentation te ajută să faci primii pași cu Qiskit — să citești, să rulezi cod și să explorezi — fără a fi nevoie să instalezi nimic. Pe măsură ce avansezi, mergi la platforma oficială IBM: Rulează pe hardware real — creează un cont IBM Cloud gratuit și o instanță Open Plan pentru a executa circuite pe computere cuantice reale. Cel mai nou conținut — platforma de învățare Qiskit de la IBM oferă cele mai noi cursuri, tutoriale și adăugiri (unele pot să nu fie încă în doQumentation). Dezvoltă local — instalează Qiskit pe propriul laptop, pentru dezvoltare serioasă. Construit pe baza documentației open-source IBM Quantum. Mulțumim echipei IBM Quantum pentru că a făcut acest conținut disponibil în mod liber sub licența CC BY-SA 4.0.","s":"Când ești pregătit pentru mai mult","u":"/","h":"#when-youre-ready-for-more","p":1}],"index":{"version":"2.3.9","fields":["t"],"fieldVectors":[["t/2",[0,2.117,1,0.953,2,0.607,3,0.331,4,2.117,5,0.442,6,2.117,7,0.331,8,0.102,9,0.748,10,0.953,11,2.117,12,2.117,13,0.607,14,2.117,15,1.173,16,2.117,17,0.607,18,0.331,19,2.117,20,1.415,21,0.953,22,0.953,23,2.117,24,2.117,25,1.415,26,2.117,27,2.117,28,2.117,29,1.415,30,2.117]],["t/4",[1,0.745,2,0.638,3,0.393,8,0.107,9,0.638,10,0.745,13,0.77,17,0.475,18,0.259,20,1.107,21,0.745,22,0.745,29,1.107,31,1.107,32,1.656,33,1.656,34,1.656,35,1.656,36,1.656,37,1.656,38,1.656,39,1.656,40,1.656,41,0.745,42,1.107,43,1.656,44,0.475,45,1.107,46,1.107,47,1.656,48,0.638,49,1.107,50,1.656,51,1.107,52,1.656,53,0.74